PORT=5000
# Local: mongodb://127.0.0.1:27017/parkease
# Production: your MongoDB Atlas connection URI
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_production_secret
# Comma-separated origins are supported, e.g. local development plus Vercel.
CLIENT_URL=http://localhost:5173,https://your-project.vercel.app

# Gmail sender used for registration and password-reset OTP emails.
# Use a 16-character Gmail App Password, never your Gmail account password.
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_APP_PASSWORD=your_16_character_gmail_app_password

# Use rzp_test_* keys for Test Mode; use separate rzp_live_* keys only after Razorpay activation.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
